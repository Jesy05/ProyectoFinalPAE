<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.proyectofinalpae.util.LogoPlantBee?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            styleClass="main-layout">

    <top>
        <VBox styleClass="main-top">
            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  styleClass="main-header">

                <LogoPlantBee alto="58" conTexto="true" color="#F5EAB9"/>

                <Separator orientation="VERTICAL" styleClass="header-separador"/>

                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Label text="Panel de control"
                           styleClass="header-panel"/>

                    <Label
                            text="Huertos verticales modulares para espacios urbanos"
                            styleClass="brand-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Cultivando un futuro sostenible"
                       styleClass="header-caption"/>

                <Button fx:id="btnInicio"
                        text="Inicio"
                        styleClass="btn-inicio"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPrincipal"
                 tabClosingPolicy="UNAVAILABLE"
                 side="TOP"
                 styleClass="plantbee-tabs">

            <tabs>
                <Tab text="Usuarios">
                    <content>
                        <fx:include source="usuario-view.fxml"/>
                    </content>
                </Tab>

                <Tab text="Colmenas">
                    <content>
                        <fx:include source="colmena-view.fxml"/>
                    </content>
                </Tab>

                <Tab text="Plantas">
                    <content>
                        <fx:include source="planta-view.fxml"/>
                    </content>
                </Tab>

                <Tab text="Riegos y alertas">
                    <content>
                        <fx:include source="riego-view.fxml"/>
                    </content>
                </Tab>

                <Tab text="Reportes">
                    <content>
                        <fx:include source="reporte-view.fxml"/>
                    </content>
                </Tab>
            </tabs>

        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              styleClass="main-footer">

            <Label
                    text="PlantBee | Gestión sostenible de huertos urbanos"/>
        </HBox>
    </bottom>

</BorderPane>
