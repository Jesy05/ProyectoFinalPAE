<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.proyectofinalpae.controller.RiegoController"
      styleClass="riegos-page"
      spacing="12">

    <Label text="Historial de riego"
           styleClass="page-title"/>

    <HBox spacing="8" alignment="CENTER_LEFT">

        <ComboBox fx:id="cbPlanta"
                  prefWidth="260"
                  promptText="Planta"/>

        <TextField fx:id="txtCantidad"
                   prefWidth="80"
                   promptText="ml"/>

        <Label text="ml" minWidth="-Infinity"/>

        <ComboBox fx:id="cbOrigen"
                  prefWidth="240"/>

        <ComboBox fx:id="cbModo"
                  prefWidth="140"/>

    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">

        <Button text="Registrar riego"
                styleClass="btn-registrar"
                onAction="#registrarRiego"
                defaultButton="true"/>

        <Button text="Eliminar riego"
                styleClass="btn-eliminar"
                onAction="#eliminarRiego"/>

        <Button text="Recargar"
                styleClass="btn-recargar"
                onAction="#recargar"/>

    </HBox>

    <Label fx:id="lblAgua"
           styleClass="agua-info"/>

    <TableView fx:id="tblRiegos"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colFecha"
                         text="Fecha" prefWidth="130"/>

            <TableColumn fx:id="colPlanta"
                         text="Planta" prefWidth="280"/>

            <TableColumn fx:id="colCantidad"
                         text="ml" prefWidth="70"/>

            <TableColumn fx:id="colOrigen"
                         text="Origen del agua" prefWidth="210"/>

            <TableColumn fx:id="colModo"
                         text="Modo" prefWidth="100"/>
        </columns>

    </TableView>

    <Separator/>

    <Label text="Alertas pendientes"
           styleClass="section-title"/>

    <HBox spacing="8">

        <Button text="Revisar sensores"
                styleClass="btn-revisar"
                onAction="#revisarSensores"/>

        <Button text="Marcar como atendida"
                styleClass="btn-atendida"
                onAction="#marcarAtendida"/>

        <Button text="Eliminar alerta"
                styleClass="btn-eliminar"
                onAction="#eliminarAlerta"/>

    </HBox>

    <TableView fx:id="tblAlertas"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colAFecha"
                         text="Fecha" prefWidth="130"/>

            <TableColumn fx:id="colAPlanta"
                         text="Planta" prefWidth="250"/>

            <TableColumn fx:id="colATipo"
                         text="Tipo" prefWidth="110"/>

            <TableColumn fx:id="colAMensaje"
                         text="Mensaje" prefWidth="420"/>
        </columns>

    </TableView>

</VBox>
